---
import { brand } from '../../data/brand';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import BuyBox from '../../components/BuyBox.astro';
import Reviews from '../../components/Reviews.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getModel, getCategory, getDepartment, categoryUrl, modelUrl, productFitsLabel, fitEntryLabel, confirmedFits, possibleFits, type Product } from '../../data/catalog';
import { getProducts, fitSummaryKind, isDigital, isBuyable, showcaseOrder, SHOW_DRAFTS } from '../../data/products';

export async function getStaticPaths() {
  const all = await getProducts();
  return all.map((p) => ({ params: { slug: p.slug }, props: { product: p, all } }));
}
const { product: p, all } = Astro.props as { product: Product; all: Product[] };
const cat = getCategory(p.category);
const dept = getDepartment(p.department);
const digital = isDigital(p);
const fits = p.models.map(getModel);
const sure = confirmedFits(p);
const maybe = possibleFits(p);
const fk = fitSummaryKind(p);
const included = p.includes.map((s) => all.find((x) => x.slug === s)).filter((x): x is Product => !!x);
const related = [
  ...all.filter((x) => x.slug !== p.slug && x.models.some((m) => p.models.includes(m))).sort(showcaseOrder),
  ...all.filter((x) => x.slug !== p.slug && x.category === p.category && !x.models.some((m) => p.models.includes(m))).sort(showcaseOrder),
].slice(0, 4);
const firstFit = fits[0] ? productFitsLabel(p, fits[0]) : sure[0] ? fitEntryLabel(sure[0]) : null;
const titleMentionsCar = fits.some((m) => p.title.toLowerCase().includes(m.name.toLowerCase().split(' ')[0])) || (!fits.length && sure.some((f) => p.title.toLowerCase().includes(f.label.toLowerCase().split(' ').pop()!)));
const title = firstFit && !titleMentionsCar ? `${p.title}, fits ${firstFit}` : p.title;
const lede = p.summary ?? p.description;
const dash = (v: unknown) => (v == null || v === '' ? '—' : String(v));
const isShareAlike = p.sources.some((s) => s.license === 'CC-BY-SA');
// No aggregateRating/review in JSON-LD until real verified reviews exist.
const ld = {
  '@context': 'https://schema.org', '@type': 'Product', name: title, description: lede ?? title,
  category: cat.name, sku: `${brand.skuPrefix}-${p.slug}`, ...(p.oem.length ? { mpn: p.oem[0] } : {}),
  brand: { '@type': 'Brand', name: brand.name },
  ...(p.images[0] ? { image: new URL(p.images[0].src, Astro.site).href } : {}),
  ...(p.priceUsd != null ? { offers: { '@type': 'Offer', price: p.priceUsd.toFixed(2), priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: new URL(Astro.url.pathname, Astro.site).href } } : {}),
};
---
<Base title={title} description={`${lede ?? p.title}.${digital ? ' Print-ready STL, instant download.' : ''}`} jsonLd={ld} noindex={p.status !== 'approved'}>
  <section class="section--tight">
    <div class="wrap">
      <Breadcrumbs items={[['Home', '/'], [dept.name, `/${dept.slug}/`], [cat.name, categoryUrl(cat)], [p.title]]} />
      <div class="layout">
        <div class="gallery">
          <ProductGallery product={p} />
        </div>

        <div class="info">
          <div class="tags">
            {p.status === 'draft' && <span class="tag">Draft listing</span>}
            {p.status === 'preview' && <span class="tag">Coming soon</span>}
            {p.preview3d && <span class="tag tag--blue">3D preview</span>}
            <a href={categoryUrl(cat)} class="tag">{cat.name}</a>
            {p.kind === 'pack' && <span class="tag tag--accent">Pack · {included.length} parts</span>}
          </div>
          <h1 class="ptitle">{p.title}</h1>

          <div class:list={['fit', fk]}>
            {fk === 'universal' && <p><strong>Universal fit.</strong> Check the dimensions against your car.</p>}
            {fk === 'unconfirmed' && <p><strong>Check fitment.</strong> We're confirming which models this fits. <a href="/support/">Ask us</a> before you buy.</p>}
            {fk === 'specific' && (
              <>
                <p class="fit-head"><span class="muted">{sure.length > 1 ? `Fits ${sure.length} models` : 'Fits'}</span></p>
                <ul class="fit-list">
                  {sure.map((f) => (
                    <li>{f.model ? <a href={modelUrl(getModel(f.model))}>{fitEntryLabel(f)}</a> : <strong>{fitEntryLabel(f)}</strong>}{f.note && <span class="muted"> · {f.note}</span>}</li>
                  ))}
                </ul>
              </>
            )}
            {maybe.length > 0 && (
              <p class="fit-maybe"><span class="muted">May also fit (not confirmed by the designer, check before you print):</span> {maybe.map((f, i) => <>{i > 0 && ', '}{fitEntryLabel(f)}{f.note && ` (${f.note})`}</>)}</p>
            )}
            {p.fitmentNote && <p class="fit-note">{p.fitmentNote}</p>}
          </div>

          {lede && <p class="lede">{lede}</p>}

          <BuyBox product={p} />

          {digital && (
            <details class="specs" open>
              <summary>Print specs</summary>
              <table class="spec">
                <tr><th>OEM part no.</th><td>{p.oem.length ? p.oem.join(', ') : 'Not verified yet'}</td></tr>
                <tr><th>Material</th><td>{p.material.recommended.join(' or ') || '—'}{p.material.avoid.length > 0 && <span class="muted"> · avoid {p.material.avoid.join(', ')}</span>}</td></tr>
                <tr><th>Layer / infill</th><td>{dash(p.print.layer)} · {dash(p.print.infill)}</td></tr>
                <tr><th>Walls / supports</th><td>{dash(p.print.walls)} · {dash(p.print.supports)}</td></tr>
                <tr><th>You get</th><td>Print-ready STL files</td></tr>
              </table>
              {p.material.note && <p class="note">{p.material.note}</p>}
            </details>
          )}
        </div>
      </div>
    </div>
  </section>

  {SHOW_DRAFTS && p.reviewFlags.length > 0 && (
    <section class="wrap"><div class="notice"><strong>Review flags (draft preview only):</strong><ul>{p.reviewFlags.map((f) => <li>{f}</li>)}</ul></div></section>
  )}

  {included.length > 0 && (
    <section class="section--tight">
      <div class="wrap">
        <h2>What's in the pack</h2>
        <div class="grid grid--2m">{included.map((x) => <ProductCard product={x} />)}</div>
      </div>
    </section>
  )}

  <section class="section--tight">
    <div class="wrap cols">
      <div>
        {digital && (
          <>
            <h2>Install</h2>
            {p.install.length ? <ol class="install">{p.install.map((s) => <li>{s}</li>)}</ol> : <p class="muted">Install notes coming soon. Questions? Reply to your order email.</p>}
            {p.print.notes && <p>{p.print.notes}</p>}
          </>
        )}
        <Reviews productTitle={p.title} physical={p.kind === 'physical'} />
      </div>
      {p.artwork && (
        <aside class="license">
          <span class="eyebrow">Photo credit</span>
          <p>
            Photo by{' '}
            {p.artwork.authorUrl ? <a href={p.artwork.authorUrl} rel="nofollow noopener" target="_blank">{p.artwork.author}</a> : <span>{p.artwork.author}</span>},{' '}
            <strong>{p.artwork.licenseLabel}</strong>,{' '}
            <a href={p.artwork.url} rel="nofollow noopener" target="_blank">source</a>. Cropped for print.
          </p>
          <p class="small">Unofficial photo print. Not affiliated with or endorsed by the vehicle's manufacturer.</p>
          <a href="/legal/attributions/" class="small">All licenses & attributions</a>
        </aside>
      )}
      {digital && (
        <aside class="license">
          <span class="eyebrow">License & credit</span>
          {p.sources.map((s) => (
            <p>
              <strong>{s.licenseLabel}</strong>. Original design by{' '}
              {s.author ? (s.authorUrl ? <a href={s.authorUrl} rel="nofollow noopener" target="_blank">{s.author}</a> : <span>{s.author}</span>) : <span class="muted">author pending verification</span>},{' '}
              <a href={s.url} rel="nofollow noopener" target="_blank">source</a>. Used under the license above.
            </p>
          ))}
          {isShareAlike && <p class="small">ShareAlike: your files are shared under the same CC BY-SA license.</p>}
          <a href="/legal/attributions/" class="small">All licenses & attributions</a>
        </aside>
      )}
    </div>
  </section>

  {related.length > 0 && (
    <section class="section--tight">
      <div class="wrap">
        <h2>You might also need</h2>
        <div class="grid grid--2m">{related.map((x) => <ProductCard product={x} />)}</div>
      </div>
    </section>
  )}

  {isBuyable(p) && (
    <div class="sticky-buy" data-sticky-buy>
      <div>
        <strong>${p.priceUsd!.toFixed(2)}</strong>
        <span>Instant download</span>
      </div>
      <a href="#buy" class="btn btn--accent">Buy now</a>
    </div>
  )}
</Base>

<style>
  .layout { display: grid; gap: 28px; }
  .gallery { align-self: start; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  .ptitle { font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .fit p { margin: 0 0 14px; font-size: .98rem; }
  .fit a { font-weight: 600; }
  .fit .fit-head { margin-bottom: 6px; }
  .fit-list { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 4px; font-size: .95rem; }
  .fit-list strong { font-weight: 600; }
  .fit .fit-maybe, .fit .fit-note { font-size: .88rem; color: var(--ink-2); }
  .fit.unconfirmed p { color: var(--accent-ink); }
  .lede { font-size: 1.05rem; }
  .specs { margin-top: 18px; padding: 4px 18px 10px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--paper-2); }
  .specs summary { cursor: pointer; padding: 12px 0; font-weight: 600; }
  .note { font-size: .82rem; color: var(--ink-3); margin: 10px 0 4px; }
  .cols { display: grid; gap: 32px; }
  .install { padding-left: 1.3em; margin-bottom: 36px; }
  .install li { margin-bottom: .6em; padding-left: .3em; }
  .install li::marker { color: var(--accent); font-weight: 700; }
  .license { padding: 22px; border-radius: var(--radius); background: var(--card); border: 1px solid var(--line); align-self: start; font-size: .92rem; color: var(--ink-2); }
  .small { font-size: .82rem; }
  .notice ul { margin: 6px 0 0; }
  .sticky-buy { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 25; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 10px 10px 18px; border-radius: 999px; background: rgba(23, 24, 28, .92); backdrop-filter: blur(12px); border: 1px solid var(--rule); box-shadow: var(--shadow); }
  .sticky-buy div { display: grid; line-height: 1.2; }
  .sticky-buy span { font-size: .75rem; color: var(--instant); }
  .sticky-buy .btn { min-height: 44px; }
  @media (min-width: 960px) {
    .layout { grid-template-columns: 1.15fr 1fr; gap: 56px; }
    .gallery { position: sticky; top: 96px; }
    .cols { grid-template-columns: 1.5fr 1fr; gap: 56px; }
    .sticky-buy { display: none; }
  }
</style>
