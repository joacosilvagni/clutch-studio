---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductBrowser from '../components/ProductBrowser.astro';
import { getProducts } from '../data/products';
const all = await getProducts();
// Accessories first: they are the headline department.
const items = [...all].sort((a, b) => Number(b.department === 'accessories') - Number(a.department === 'accessories'));
---
<Base title="Shop all" description="All car accessories and 3D print files for classic and youngtimer cars.">
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={[['Home', '/'], ['Shop all']]} />
      <h1>Shop all</h1>
      <p class="lede">Accessories and 3D files in one place. Filter by category, or pick your car to see what fits.</p>
      <ProductBrowser items={items} />
    </div>
  </section>
</Base>
