---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categories, type Category } from '../../data/catalog';
import { productsForCategory } from '../../data/products';
export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}
const { category: c } = Astro.props as { category: Category };
const items = await productsForCategory(c.slug);
---
<Base title={`${c.name}: 3D printable classic car parts`} description={`Print-ready STL/3MF ${c.name.toLowerCase()} for classic and youngtimer cars.`}>
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={[['Home', '/'], ['Parts', '/parts/'], [c.name]]} />
      <h1>{c.name}</h1>
      {items.length ? <div class="grid">{items.map((p) => <ProductCard product={p} />)}</div>
        : <p class="notice">Nothing here yet. <a href="/support/#request">Request a part</a>.</p>}
    </div>
  </section>
</Base>
