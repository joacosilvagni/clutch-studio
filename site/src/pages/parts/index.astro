---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PartArt from '../../components/PartArt.astro';
import { categories } from '../../data/catalog';
import { getProducts } from '../../data/products';
const all = await getProducts();
const count = (s: string) => all.filter((p) => p.category === s).length;
---
<Base title="Parts by type" description="Browse 3D printable classic car parts by type: clips, trim, gauge pods, knobs, cupholders, exterior, engine bay and workshop tools.">
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={[['Home', '/'], ['Parts']]} />
      <h1>Parts by type</h1>
      <p class="lede">Same part, many cars. Browse by what broke.</p>
      <div class="grid">
        {categories.map((c) => (
          <a class="cat" href={`/parts/${c.slug}/`}>
            <PartArt glyph={c.glyph} />
            <h2>{c.name}</h2>
            <span class="mono muted">{count(c.slug)} files</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .cat { display: grid; gap: 8px; padding: 8px 8px 16px; background: var(--card); border: 1px solid var(--rule); border-radius: var(--radius); text-decoration: none; }
  .cat:hover { border-color: var(--ink); color: inherit; }
  h2 { font-size: 1.4rem; margin: 6px 4px 0; }
  .mono { padding-inline: 4px; }
</style>
