---
import { brand } from '../../data/brand';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { models, getMake, getCategory, yearsLabel, fitsLabel, type Model } from '../../data/catalog';
import { productsForModel } from '../../data/products';

export function getStaticPaths() {
  return models.map((m) => ({ params: { model: m.slug }, props: { model: m } }));
}
const { model } = Astro.props as { model: Model };
const make = getMake(model.make);
const items = await productsForModel(model.slug);
const cats = [...new Set(items.map((p) => p.category))].map(getCategory);
const title = `3D printable parts for ${make.name} ${model.name} (${yearsLabel(model)})`;
---
<Base title={title} description={`STL and 3MF files for discontinued ${make.name} ${model.name} parts, ${yearsLabel(model)}. ${model.blurb}`}>
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={[['Home', '/'], ['Shop by car', '/makes/'], [make.name, `/makes/#${make.slug}`], [model.name]]} />
      <p class="eyebrow">{make.name} · {yearsLabel(model)}</p>
      <h1>{model.fullName}</h1>
      <p class="lede">{model.blurb} Every file below is listed as fitting {fitsLabel(model)}; check the years and part number on each sheet.</p>

      {cats.length > 1 && (
        <div class="filters" role="group" aria-label="Filter by part type" data-filters>
          <button type="button" aria-pressed="true" data-cat="">All ({items.length})</button>
          {cats.map((c) => <button type="button" aria-pressed="false" data-cat={c.slug}>{c.name} ({items.filter((p) => p.category === c.slug).length})</button>)}
        </div>
      )}

      {items.length ? (
        <div class="grid" data-list>
          {items.map((p) => <div data-cat={p.category}><ProductCard product={p} /></div>)}
        </div>
      ) : (
        <p class="notice">No files for this model yet. <a href="/support/#request">Request a part</a> and we'll prioritize it.</p>
      )}

      <p class="notice fine">
        {brand.name} is not affiliated with {make.name}. "{make.name}" and "{model.name}" are used only to describe which vehicle a part fits.
      </p>
    </div>
  </section>
</Base>

<script>
  const bar = document.querySelector('[data-filters]');
  const cards = document.querySelectorAll<HTMLElement>('[data-list] > [data-cat]');
  bar?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    bar.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const cat = b.dataset.cat;
    cards.forEach((c) => (c.hidden = !!cat && c.dataset.cat !== cat));
  });
</script>

<style>
  .filters { display: flex; gap: 8px; overflow-x: auto; padding: 4px 0 18px; margin-top: 10px; scrollbar-width: thin; }
  .filters button { flex: none; min-height: 40px; padding: 0 16px; border-radius: 999px; border: 1.5px solid var(--ink); background: transparent; font: 600 .95rem var(--display); text-transform: uppercase; letter-spacing: .05em; cursor: pointer; color: var(--ink); }
  .filters button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .fine { margin-top: 32px; font-size: .85rem; }
</style>
