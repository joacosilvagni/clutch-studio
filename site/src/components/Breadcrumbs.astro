---
interface Props { items: [string, string?][] }
const { items } = Astro.props;
const ld = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: items.map(([name, href], i) => ({ '@type': 'ListItem', position: i + 1, name, ...(href ? { item: new URL(href, Astro.site).href } : {}) })),
};
---
<nav aria-label="Breadcrumb" class="crumbs">
  <ol>{items.map(([name, href]) => <li>{href ? <a href={href}>{name}</a> : <span aria-current="page">{name}</span>}</li>)}</ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<style>
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 8px 0 22px; font: 400 .82rem/1.4 var(--body); color: var(--ink-3); }
  .crumbs li + li::before { content: '/'; margin-right: 6px; color: var(--ink-3); opacity: .5; }
  .crumbs a { text-decoration: none; }
</style>
