---
import PartArt from './PartArt.astro';
import { type Product, getCategory, getModel, productFitsLabel, priceLabel } from '../data/catalog';
import { productUrl, fitSummaryKind } from '../data/products';
interface Props { product: Product }
const { product: p } = Astro.props;
const cat = getCategory(p.category);
const fits = p.models.map((s) => getModel(s));
const fk = fitSummaryKind(p);
const fitLine =
  fk === 'universal' ? 'Universal fit' :
  fk === 'unconfirmed' ? 'Check fitment' :
  fits.length > 2 ? `Fits ${fits.length} models` : `Fits ${fits.map((m) => productFitsLabel(p, m)).join(' · ')}`;
---
<article class="card" data-product data-cat={p.category} data-dept={p.department} data-models={p.models.join(' ')} data-universal={fk === 'universal' ? '1' : '0'}>
  <a href={productUrl(p)} class="link">
    <PartArt glyph={cat.glyph} label={p.oem[0] ? `OEM ${p.oem[0]}` : cat.short} />
    <div class="body">
      <div class="meta">
        {p.status === 'draft' && <span class="tag tag--accent">Draft</span>}
        <span class:list={['tag', p.department === 'accessories' ? 'tag--green' : 'tag--blue']}>{p.department === 'accessories' ? 'Ships to you' : '3D file'}</span>
        {p.kind === 'pack' && <span class="tag tag--accent">Pack</span>}
        {p.priceUsd === 0 && <span class="tag tag--green">Free</span>}
      </div>
      <h3>{p.title}</h3>
      <p class="fits">{fitLine}</p>
      <p class="price">{priceLabel(p)}{p.department === '3d-files' && <span class="muted"> · STL + 3MF</span>}</p>
    </div>
  </a>
</article>
<style>
  .card { background: var(--card); border: 1px solid var(--rule); border-radius: var(--radius); box-shadow: var(--shadow); transition: transform .15s ease, border-color .15s ease; height: 100%; }
  .card:hover { transform: translateY(-2px); border-color: var(--ink-3); }
  .link { display: block; text-decoration: none; color: inherit; padding: 8px; height: 100%; }
  .link:hover { color: inherit; }
  .body { padding: 12px 6px 6px; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
  h3 { margin-bottom: 4px; }
  .fits { font-size: .9rem; color: var(--ink-2); margin-bottom: 10px; }
  .price { font: 600 1rem/1 var(--mono); margin: 0; }
</style>
