---
import Logo from './Logo.astro';
import { makes, modelsForMake, categories } from '../data/catalog';
const path = Astro.url.pathname;
const nav = [
  { href: '/makes/', label: 'Shop by car' },
  { href: '/parts/', label: 'Parts' },
  { href: '/free-library/', label: 'Free Library' },
  { href: '/how-it-works/', label: 'How it works' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <Logo />
    <nav class="desktop" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="actions">
      <a href="/cart/" class="cart" aria-label="Cart (0 items)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6.2"/><circle cx="10" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg>
        <span class="count">0</span>
      </a>
      <details class="mobile">
        <summary aria-label="Menu"><span></span><span></span><span></span></summary>
        <div class="panel">
          {nav.map((n) => <a class="big" href={n.href}>{n.label}</a>)}
          <p class="eyebrow">Popular cars</p>
          <div class="chips">
            {makes.flatMap((mk) => modelsForMake(mk.slug).slice(0, 1)).map((m) => <a href={`/${m.slug}/`} class="tag">{m.slug.replace(/-/g, ' ')}</a>)}
          </div>
          <p class="eyebrow">Part types</p>
          <div class="chips">
            {categories.map((c) => <a href={`/parts/${c.slug}/`} class="tag tag--blue">{c.short}</a>)}
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--rule); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; }
  .desktop { display: none; gap: 28px; }
  .desktop a { font: 600 1.05rem/1 var(--display); text-transform: uppercase; letter-spacing: 0.06em; text-decoration: none; padding: 8px 0; border-bottom: 2px solid transparent; }
  .desktop a[aria-current='page'] { border-color: var(--accent); }
  .actions { display: flex; align-items: center; gap: 6px; }
  .cart { position: relative; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; }
  .cart:hover { background: var(--paper-2); color: var(--ink); }
  .count { position: absolute; top: 4px; right: 2px; min-width: 18px; height: 18px; border-radius: 9px; background: var(--ink); color: var(--paper); font: 600 0.65rem/18px var(--mono); text-align: center; }
  .mobile summary { list-style: none; width: 44px; height: 44px; display: grid; place-content: center; gap: 5px; cursor: pointer; border-radius: 50%; }
  .mobile summary::-webkit-details-marker { display: none; }
  .mobile summary span { display: block; width: 22px; height: 2px; background: var(--ink); transition: transform 0.15s; }
  .mobile[open] summary span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .mobile[open] summary span:nth-child(2) { opacity: 0; }
  .mobile[open] summary span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .panel { position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); border-bottom: 1px solid var(--rule); padding: 12px 16px 24px; max-height: calc(100dvh - 100px); overflow: auto; box-shadow: var(--shadow); }
  .big { display: block; font: 700 1.8rem/1.2 var(--display); text-transform: uppercase; text-decoration: none; padding: 8px 0; border-bottom: 1px dashed var(--rule); }
  .panel .eyebrow { margin-top: 20px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a { text-decoration: none; }
  @media (min-width: 900px) {
    .desktop { display: flex; }
    .mobile { display: none; }
  }
</style>
