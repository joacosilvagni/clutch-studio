---
import Logo from './Logo.astro';
import { departments, categoriesFor, categoryUrl } from '../data/catalog';
const path = Astro.url.pathname;
const nav = [
  { href: '/3d-files/', label: '3D Print Files' },
  { href: '/accessories/', label: 'Accessories' },
  { href: '/free-library/', label: 'Free Library' },
  { href: '/how-it-works/', label: 'How it works' },
];
---
<div class="topline">
  <div class="wrap">
    <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" fill="currentColor" /></svg>3D files download instantly after payment</span>
    <span class="hide-s">Secure checkout with PayPal</span>
  </div>
</div>
<header class="site-header">
  <div class="wrap bar">
    <Logo />
    <nav class="desktop" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="actions">
      <a href="/shop/" class="icon hide-s" aria-label="Search the shop">
        <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <a href="/cart/" class="icon cart" aria-label="Cart">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6.2"/><circle cx="10" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg>
        <span class="count" data-cart-count hidden>0</span>
      </a>
      <details class="mobile">
        <summary aria-label="Menu"><span></span><span></span><span></span></summary>
        <div class="panel-m">
          <a class="big" href="/shop/">Shop all</a>
          {nav.map((n) => <a class="big" href={n.href}>{n.label}</a>)}
          {departments.map((d) => (
            <>
              <p class="eyebrow">{d.name}</p>
              <div class="chips">
                {categoriesFor(d.slug).map((c) => <a href={categoryUrl(c)} class="tag">{c.short}</a>)}
              </div>
            </>
          ))}
          <p class="eyebrow">Specific car?</p>
          <a href="/fits/" class="tag">Browse by car</a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Keeps the cart badge in sync with the cart stored by the checkout script (slugs only).
  const KEY = 'cs-cart';
  const badge = document.querySelector<HTMLElement>('[data-cart-count]');
  const read = (): unknown[] => {
    try {
      const v = JSON.parse(localStorage.getItem(KEY) || '[]');
      return Array.isArray(v) ? v : Array.isArray(v?.items) ? v.items : [];
    } catch {
      return [];
    }
  };
  const render = () => {
    if (!badge) return;
    const n = read().length;
    badge.textContent = String(n);
    badge.hidden = n === 0;
  };
  render();
  window.addEventListener('cart:change', render);
  window.addEventListener('storage', (e) => e.key === KEY && render());
</script>

<style>
  .topline { background: var(--deep); border-bottom: 1px solid var(--line); font-size: .78rem; color: var(--ink-2); }
  .topline .wrap { display: flex; justify-content: space-between; gap: 16px; padding-block: 8px; }
  .topline span { display: inline-flex; align-items: center; gap: 6px; }
  .topline svg { width: 13px; height: 13px; color: var(--instant); }
  .site-header { position: sticky; top: 0; z-index: 30; background: rgba(15, 16, 18, .82); backdrop-filter: saturate(140%) blur(14px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 70px; }
  .desktop { display: none; gap: 30px; }
  .desktop a { font: 500 .95rem/1 var(--body); text-decoration: none; color: var(--ink-2); padding: 10px 0; position: relative; }
  .desktop a:hover { color: var(--ink); }
  .desktop a[aria-current='page'] { color: var(--ink); }
  .desktop a[aria-current='page']::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; border-radius: 2px; background: var(--accent); }
  .actions { display: flex; align-items: center; gap: 4px; }
  .icon { position: relative; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; color: var(--ink); }
  .icon:hover { background: rgba(255, 255, 255, .06); color: var(--ink); }
  .count { position: absolute; top: 3px; right: 1px; min-width: 19px; height: 19px; padding: 0 5px; border-radius: 10px; background: var(--accent); color: #fff; font: 700 .68rem/19px var(--body); text-align: center; }
  .count[hidden] { display: none; }
  .mobile summary { list-style: none; width: 44px; height: 44px; display: grid; place-content: center; gap: 5px; cursor: pointer; border-radius: 50%; }
  .mobile summary::-webkit-details-marker { display: none; }
  .mobile summary span { display: block; width: 22px; height: 2px; border-radius: 2px; background: var(--ink); transition: transform .15s; }
  .mobile[open] summary span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .mobile[open] summary span:nth-child(2) { opacity: 0; }
  .mobile[open] summary span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .mobile:not([open]) .panel-m { display: none; }
  .panel-m { position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); border-bottom: 1px solid var(--line); padding: 12px 16px 28px; max-height: calc(100dvh - 110px); overflow: auto; box-shadow: var(--shadow); }
  .big { display: block; font: 700 1.9rem/1.2 var(--display); text-transform: uppercase; text-decoration: none; padding: 8px 0; border-bottom: 1px solid var(--line); }
  .panel-m .eyebrow { margin-top: 22px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  @media (max-width: 560px) { .hide-s { display: none !important; } }
  @media (min-width: 960px) {
    .desktop { display: flex; }
    .mobile { display: none; }
  }
</style>
