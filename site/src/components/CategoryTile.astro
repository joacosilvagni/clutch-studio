---
import PartArt from './PartArt.astro';
import { categoryUrl, type Category } from '../data/catalog';
import { thumbSrc } from '../data/products';
interface Props { category: Category; count: number; image?: { src: string } }
const { category: c, count, image } = Astro.props;
const unit = c.department === 'accessories' ? 'product' : 'file';
---
<a href={categoryUrl(c)} class="cat">
  {image ? <img src={thumbSrc(image.src)} alt="" width="600" height="600" loading="lazy" /> : <PartArt glyph={c.glyph} />}
  <span class="t"><strong>{c.name}</strong><small>{count ? `${count} ${unit}${count === 1 ? '' : 's'}` : 'Coming soon'}</small></span>
</a>
<style>
  .cat { position: relative; display: block; aspect-ratio: 1; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: #1b1b1d; text-decoration: none; }
  .cat img, .cat :global(.art) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: auto; border-radius: 0; transition: transform .5s; }
  .cat:hover img { transform: scale(1.06); }
  .cat::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(0, 0, 0, .85)); }
  .t { position: absolute; left: 14px; right: 14px; bottom: 12px; z-index: 1; display: grid; gap: 2px; }
  .t strong { font: 700 1.2rem/1.05 var(--display); text-transform: uppercase; color: #fff; }
  .t small { color: var(--ink-2); font-size: .78rem; }
  .cat:hover { color: inherit; border-color: rgba(255, 255, 255, .2); }
</style>
